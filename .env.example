# Documentation of workflow variable names. Do NOT copy production secrets into Codex.
# Real API validations consume GitHub Secrets in manual GitHub Actions workflows.
AUTO_PUBLISH=false
MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CHROME_EXECUTABLE=/usr/bin/chromium

# Production media provider switches (demo ignores them)
IMAGE_PROVIDER=cloudflare
STOCK_PROVIDER=auto
TTS_PROVIDER=chatterbox-nano
# Optional legacy stock support; never a required development/production secret.
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
# Licensed production score; procedural music is an explicit fallback
MUSIC_PATH=
MUSIC_LICENSE=

# FREE-FIRST defaults. Do not paste credentials into tracked files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set true only for a free-tier project; paid Gemini is not supported.
GEMINI_FREE_TIER_CONFIRMED=false
YOUTUBE_DATA_API_KEY=
BENCHMARK_CHANNEL=@ancientlivesHQ
TARGET_DURATION_MODE=benchmark_median
QUALITY_FLOOR=80
MAX_GENERATED_IMAGES_PER_VIDEO=256
AI_VIDEO_ENABLED=false
MODEL_CACHE_DIR=.cache/models
KOKORO_VOICE=am_michael
KOKORO_AUDITION_VOICES=am_michael,bm_george,bm_daniel
ELEVENLABS_AUDITION_VOICE_IDS=
ELEVENLABS_PRONUNCIATION_DICTIONARY_ID=
ELEVENLABS_PRONUNCIATION_DICTIONARY_VERSION=
PRONUNCIATIONS_PATH=

# Hard zero-spend defaults; API keys alone never authorize paid calls.
FREE_ONLY=true
PAID_FALLBACK_ENABLED=false
MAX_PAID_COST_USD=0
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Only true for an actual Workers FREE account (paid accounts refused).
CLOUDFLARE_FREE_PLAN_CONFIRMED=false
FREE_QUOTA_LEDGER_PATH=.cache/quota/free-quota-ledger.json
HF_HOME=.cache/huggingface
LOCAL_AI_PYTHON=.venv-ai/bin/python

# Optional read-only connection diagnosis / future social integration. GitHub Secrets only.
ZERNIO_API_KEY=
